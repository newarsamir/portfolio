# Copy to .env.local for local work. Add the same values in Vercel:
# Project -> Settings -> Environment Variables.

# Supabase project URL (Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase secret key (sb_secret_...) or the legacy service_role key.
# Server only. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Password for /admin. Use a long one.
ADMIN_PASSWORD=

# Random string used to sign the admin cookie. Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Public URL of the site, no trailing slash. Used for SEO tags and the sitemap.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
